# Copy to .env on the VPS (never commit .env).

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Docker).
TUNNEL_TOKEN=

# Host port bound to 127.0.0.1 only (debug). Change it if 18473 is already used on the VPS.
HUB_HOST_PORT=18473

# Pin a specific cloudflared version for real deployments, e.g. 2025.11.1
CLOUDFLARED_TAG=latest

# Public URL of the site (used for absolute links, sitemap, OpenGraph).
Hub__PublicBaseUrl=https://mth.mimehub.top

# SHA-256 hex of the admin token. Generate token + hash with:
#   dotnet run --project scripts/tools/ManifestTool -- token
# Keep the TOKEN on your dev machine (MINITOOLS_ADMIN_TOKEN); put only the SHA256 here.
Hub__AdminTokenSha256=

# Public signing key from scripts/new-signing-key.ps1, on ONE line with literal \n separators.
Hub__PublicKeyPem=

# Optional: upload limit in MB (Cloudflare Free caps request bodies at 100 MB).
# Hub__MaxUploadMb=95
