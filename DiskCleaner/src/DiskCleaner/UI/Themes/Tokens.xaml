<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Design tokens (dark, Fluent-style). Mọi view chỉ dùng token, không hardcode màu. ===== -->
    <Color x:Key="BgColor">#0E1014</Color>
    <Color x:Key="SurfaceColor">#161920</Color>
    <Color x:Key="Surface2Color">#1D212A</Color>
    <Color x:Key="SurfaceHoverColor">#242934</Color>
    <Color x:Key="BorderColor">#2A303C</Color>
    <Color x:Key="TextColor">#E8EAF0</Color>
    <Color x:Key="TextMutedColor">#8B93A7</Color>
    <Color x:Key="AccentColor">#6D5EF6</Color>
    <Color x:Key="AccentHoverColor">#8174FF</Color>
    <Color x:Key="AccentEndColor">#A35BF0</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F5A524</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="OverlayHoverColor">#14FFFFFF</Color>
    <Color x:Key="OverlayPressColor">#26000000</Color>
    <Color x:Key="OverlayNoneColor">#00FFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#266D5EF6"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F5A524"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2622C55E"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#40FFFFFF"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientDiagonal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Radius -->
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">10</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="HeadingSize">26</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="SubtitleSize">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BodySize">14</sys:Double>

    <!-- Shadow cho card (không dùng chung instance để tránh vấn đề Freeze) -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" Opacity="0.25" ShadowDepth="4" Direction="270" Color="#000000"/>
</ResourceDictionary>
