<UserControl x:Class="DiskCleaner.UI.Views.LargeFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskCleaner.UI.Localization"
             xmlns:ctl="clr-namespace:DiskCleaner.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Large.Title}" Style="{StaticResource HeadingText}"/>
            <TextBlock Text="{DynamicResource Large.Subtitle}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar dạng card -->
        <Border Grid.Row="1" Style="{StaticResource FlatCardStyle}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Large.Field.Root}" Style="{StaticResource CaptionText}" Margin="2,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE712;" FontFamily="{StaticResource IconFont}" Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}" Padding="0" Width="38" ToolTip="{DynamicResource Common.Browse}"/>
                        <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0" Width="120">
                    <TextBlock Text="{DynamicResource Large.Field.MinMb}" Style="{StaticResource CaptionText}" Margin="2,0,0,4"/>
                    <TextBox Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0" Width="120">
                    <TextBlock Text="{DynamicResource Large.Field.MaxResults}" Style="{StaticResource CaptionText}" Margin="2,0,0,4"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox Text="{Binding MaxResults, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{DynamicResource Common.Scan}" Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="88"/>
                    <Button Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng kết quả -->
        <Border Grid.Row="2" Style="{StaticResource FlatCardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Items}" SelectionMode="Extended" CanUserSortColumns="True"
                          Margin="0,4,0,4">
                    <DataGrid.Columns>
                        <DataGridTextColumn loc:L.HeaderKey="Large.Col.Path" Binding="{Binding FullPath}" Width="*" SortMemberPath="FullPath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn loc:L.HeaderKey="Large.Col.Size" Width="190" SortMemberPath="SizeBytes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="76" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Text="{Binding SizeBytes, Converter={StaticResource BytesToString}}"/>
                                        <ProgressBar Height="6" Maximum="100" Value="{Binding Ratio, Mode=OneWay}"
                                                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn loc:L.HeaderKey="Large.Col.Modified" Width="150" SortMemberPath="LastWriteLocal"
                                            Binding="{Binding LastWriteLocal, StringFormat='yyyy-MM-dd HH:mm'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ctl:EmptyState Icon="&#xE7C3;" Title="{DynamicResource Large.Empty.Title}" Hint="{DynamicResource Large.Empty.Hint}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Thanh dưới: trạng thái + hành động -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,8"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Large.OpenFolder}" Command="{Binding OpenFolderCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"/>
                    <Button Content="{DynamicResource Large.MoveToRecycleBin}" Command="{Binding MoveToRecycleBinCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}"
                            Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
