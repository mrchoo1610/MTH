<UserControl x:Class="DiskCleaner.UI.Views.CleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskCleaner.UI.Localization">
    <UserControl.Resources>
        <!-- Pill dung lượng: màu chữ theo SizeKind -->
        <Style x:Key="SizePill" TargetType="Border" BasedOn="{StaticResource PillStyle}">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SizeKind}" Value="AdminRequired">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SizePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SizeKind}" Value="NotScanned">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SizeKind}" Value="Unavailable">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SizeKind}" Value="AdminRequired">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: tiêu đề + chip tổng dung lượng đã chọn -->
        <DockPanel Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}" Background="{StaticResource AccentSoftBrush}"
                    Padding="14,6" VerticalAlignment="Top" Margin="16,4,0,0">
                <TextBlock Text="{Binding SelectedChipText}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
            </Border>
            <StackPanel>
                <TextBlock Text="{DynamicResource Clean.Title}" Style="{StaticResource HeadingText}"/>
                <TextBlock Text="{DynamicResource Clean.Subtitle}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="-16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,6,6,18">

                <!-- Kết quả sau khi dọn -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,22" Padding="20,18"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Clean.OpenLog}" Command="{Binding OpenLogCommand}"
                                    MinHeight="32" Padding="12,0" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{StaticResource SuccessSoftBrush}"
                                    Margin="0,0,14,0">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="18"
                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Clean.Result.Title}" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding ResultSummaryText}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Results}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn loc:L.HeaderKey="Clean.Col.Item" Binding="{Binding RuleName, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn loc:L.HeaderKey="Clean.Col.Freed" Binding="{Binding Freed, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn loc:L.HeaderKey="Clean.Col.Deleted" Binding="{Binding FilesDeleted, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn loc:L.HeaderKey="Clean.Col.Skipped" Binding="{Binding FilesSkipped, Mode=OneWay}" Width="110"/>
                                <DataGridTemplateColumn loc:L.HeaderKey="Clean.Col.Notes" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Note}" ToolTip="{Binding NoteTooltip}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource WarningBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Empty state (chưa quét) -->
                <Border Style="{StaticResource FlatCardStyle}" Padding="18,14" Margin="0,0,0,22"
                        Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource Surface2Brush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="18" Opacity="0.7"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Clean.Empty.Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Clean.Empty.Hint}" Style="{StaticResource SubtitleText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Các nhóm rule -->
                <ItemsControl ItemsSource="{Binding Groups}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <DockPanel Margin="4,0,4,10">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding HasTotal, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding IconGlyph}" Style="{StaticResource IconText}" FontSize="14"
                                               Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="16,14"
                                                    Margin="0,0,0,10" Opacity="{Binding RowOpacity}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                            Background="{StaticResource Surface2Brush}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource IconText}" FontSize="17"
                                                                   Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                                                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="9,5"
                                                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="12"
                                                                           Foreground="{StaticResource WarningBrush}" Margin="0,2,7,0" VerticalAlignment="Top"/>
                                                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12"
                                                                           Foreground="{StaticResource WarningBrush}"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource SizePill}" ToolTip="{Binding SizeTooltip}">
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource SizePillText}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="16" Margin="12,0,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                               ToolTip="{DynamicResource Clean.Admin.Tooltip}"
                                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}"/>

                                                    <!-- Rule tùy chỉnh: chỉ gỡ khỏi danh sách, không xóa file -->
                                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                                            Width="34" Height="34" MinHeight="34" Padding="0" VerticalAlignment="Center"
                                                            ToolTip="{DynamicResource Clean.Custom.Remove}"
                                                            Command="{Binding DataContext.RemoveCustomRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="15"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Button>

                                                    <CheckBox Grid.Column="5" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Thanh hành động dính đáy -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18,12" Margin="0,10,0,0" MinHeight="64">
            <Grid>
                <!-- Rảnh: tóm tắt + Quét / Dọn dẹp -->
                <Grid Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SelectionSummaryText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Status}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Clean.ScanButton}" Command="{Binding ScanCommand}" MinWidth="88"/>
                        <Button Content="{Binding CleanButtonText}" Command="{Binding CleanCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="150"/>
                    </StackPanel>
                </Grid>
                <!-- Đang chạy: progress + Hủy -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,8,0,6"/>
                        <TextBlock Text="{Binding CurrentText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                                   MinHeight="16"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}"
                            VerticalAlignment="Center" MinWidth="88"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
