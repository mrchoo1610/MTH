<UserControl x:Class="DiskCleaner.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DiskCleaner.UI.Controls">
    <UserControl.Resources>
        <!-- Chip sức khỏe ổ đĩa: màu theo Health -->
        <Style x:Key="HealthChip" TargetType="Border" BasedOn="{StaticResource PillStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Critical">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HealthText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="14,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Overview.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{DynamicResource Overview.Title}" Style="{StaticResource HeadingText}"/>
                <TextBlock Text="{DynamicResource Overview.Subtitle}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="-16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,6,6,24">

                <!-- Hero: ổ hệ thống với donut -->
                <Border Style="{StaticResource CardStyle}" Padding="28" Margin="0,0,0,18"
                        Visibility="{Binding HasDrives, Converter={StaticResource BoolToVisibility}}">
                    <Grid DataContext="{Binding PrimaryDrive}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="176" Height="176" VerticalAlignment="Center">
                            <ctl:DonutChart Value="{Binding UsedPercent, Mode=OneWay}" Thickness="14"
                                            Track="{StaticResource Surface2Brush}"
                                            Stroke="{Binding UsedPercent, Mode=OneWay, Converter={StaticResource PercentToBrush}}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding UsedPercentText, Mode=OneWay}" FontSize="32" FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Overview.UsedSuffix}" Style="{StaticResource CaptionText}"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource HealthChip}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HealthText, Mode=OneWay}" Style="{StaticResource HealthText}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Label, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock>
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="0,26,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Overview.Used}" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding UsedText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Overview.Free}" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding FreeText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Overview.Total}" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding TotalText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tiềm năng giải phóng (gradient) -->
                <Border CornerRadius="{StaticResource CardRadius}" Padding="28" Margin="0,0,0,18"
                        Background="{StaticResource AccentGradientDiagonal}" Effect="{StaticResource CardShadow}"
                        Visibility="{Binding HasDrives, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Overview.Reclaim.Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnAccentBrush}" Opacity="0.85"/>
                            <TextBlock Text="{Binding ReclaimValueText}" FontSize="32" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnAccentBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{DynamicResource Overview.Reclaim.Hint}" TextWrapping="Wrap" FontSize="13" Margin="0,6,24,0"
                                       Foreground="{StaticResource OnAccentBrush}" Opacity="0.8"
                                       Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                            <TextBlock Text="{DynamicResource Overview.Reclaim.AdminNote}" TextWrapping="Wrap" FontSize="13" Margin="0,6,24,0"
                                       Foreground="{StaticResource OnAccentBrush}" Opacity="0.8"
                                       Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolToVisibility}}"/>
                            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,24,0" MaxWidth="360" HorizontalAlignment="Left"
                                         Width="360" Background="{StaticResource GlassBrush}" Foreground="{StaticResource OnAccentBrush}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,8,24,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource OnAccentBrush}" Opacity="0.85"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="160">
                            <Button Content="{DynamicResource Overview.QuickScan}" Command="{Binding QuickScanCommand}"
                                    Style="{StaticResource OnAccentSolidButton}"/>
                            <Button Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}"
                                    Style="{StaticResource OnAccentButton}" Margin="0,8,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Content="{DynamicResource Overview.ViewDetails}" Command="{Binding GoToCleanCommand}"
                                    Style="{StaticResource OnAccentButton}" Margin="0,8,0,0"
                                    Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Ổ đĩa khác -->
                <StackPanel Visibility="{Binding HasOtherDrives, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource Overview.OtherDrives}" FontSize="15" FontWeight="SemiBold" Margin="2,2,0,10"/>
                    <ItemsControl ItemsSource="{Binding OtherDrives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="18" Width="300" Margin="0,0,16,16">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Margin="0,12" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Foreground="{Binding UsedPercent, Mode=OneWay, Converter={StaticResource PercentToBrush}}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText, Mode=OneWay}" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding FreeText, Mode=OneWay}" Style="{StaticResource CaptionText}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Empty state -->
                <ctl:EmptyState Icon="&#xEDA2;" Title="{DynamicResource Overview.Empty.Title}"
                                Hint="{DynamicResource Overview.Empty.Hint}" Margin="0,40"
                                Visibility="{Binding HasDrives, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
