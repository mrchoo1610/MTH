<UserControl x:Class="DiskCleaner.UI.Views.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskCleaner.UI.ViewModels"
             xmlns:ctl="clr-namespace:DiskCleaner.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="19" Height="19">
                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Style="{StaticResource ExpanderToggle}" ClickMode="Press"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Border x:Name="Bd" Grid.Column="1" Background="Transparent" Padding="6,7" CornerRadius="8" Margin="0,1">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Analyzer.Title}" Style="{StaticResource HeadingText}"/>
            <TextBlock Text="{DynamicResource Analyzer.Subtitle}" Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar dạng card -->
        <Border Grid.Row="1" Style="{StaticResource FlatCardStyle}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="{DynamicResource Common.Browse}" Command="{Binding BrowseCommand}"/>
                    <Button Content="{DynamicResource Common.Scan}" Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="88"/>
                    <Button Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <!-- Hàng 2: thư mục đang chọn + Thêm vào Dọn dẹp -->
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding AddToCleanCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="12,0,0,0" MinWidth="168" ToolTip="{Binding AddButtonTooltip}"
                        ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="13" Margin="0,1,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AddButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" Margin="2,0,10,0"
                           Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedPathText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding SelectedPathText}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Bảng cây dung lượng -->
        <Border Grid.Row="2" Style="{StaticResource FlatCardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hàng tiêu đề cột: cùng độ rộng với các cột trong item -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="31,11,22,11">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="80" Text="{DynamicResource Analyzer.Col.Files}" TextAlignment="Right"
                                   Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock DockPanel.Dock="Right" Width="140" Text="{DynamicResource Analyzer.Col.Percent}" Margin="10,0,0,0"
                                   Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock DockPanel.Dock="Right" Width="90" Text="{DynamicResource Analyzer.Col.Size}" TextAlignment="Right"
                                   Style="{StaticResource ColumnHeaderText}"/>
                        <TextBlock Text="{DynamicResource Analyzer.Col.Name}" Style="{StaticResource ColumnHeaderText}"/>
                    </DockPanel>
                </Border>

                <TreeView Grid.Row="1" ItemsSource="{Binding Roots}" ItemContainerStyle="{StaticResource TreeItemStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                            <DockPanel Background="Transparent" LastChildFill="True" ContextMenuOpening="OnNodeContextMenuOpening">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding AddMenuText}" Command="{Binding AddToCleanCommand}"/>
                                        <MenuItem Header="{DynamicResource Analyzer.Menu.OpenExplorer}" Command="{Binding OpenInExplorerCommand}"/>
                                        <MenuItem Header="{DynamicResource Analyzer.Menu.CopyPath}" Command="{Binding CopyPathCommand}"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <TextBlock DockPanel.Dock="Right" Width="80" Text="{Binding FileCountText}" TextAlignment="Right"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Width="140" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ProgressBar Width="80" Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PercentText}" Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Width="90" Text="{Binding SizeText}" TextAlignment="Right" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"
                                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource Analyzer.AccessDenied}"
                                               Visibility="{Binding IsAccessDenied, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="360" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <ctl:EmptyState Grid.Row="1" Icon="&#xE9D9;" Title="{DynamicResource Analyzer.Empty.Title}"
                                Hint="{DynamicResource Analyzer.Empty.Hint}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8"
                         Height="6"/>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionText}" ToolTip="{Binding Status}"/>
        </StackPanel>
    </Grid>
</UserControl>
