<UserControl x:Class="DiskCleaner.UI.Views.AddCustomRuleContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480" Focusable="False">
    <StackPanel>
        <TextBlock Text="{DynamicResource Custom.Dialog.Intro}" TextWrapping="Wrap" LineHeight="20"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <!-- Thông tin thư mục -->
        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Custom.Dialog.Path}" Style="{StaticResource CaptionText}"/>
                <TextBlock Text="{Binding FullPath}" TextWrapping="Wrap" Margin="0,2,0,10" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Custom.Dialog.Size}" Style="{StaticResource CaptionText}"/>
                <TextBlock Text="{Binding SizeSummary}" Margin="0,2,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource Custom.Dialog.Name}" Style="{StaticResource CaptionText}" Margin="0,16,0,6"/>
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>

        <TextBlock Text="{DynamicResource Custom.Dialog.MinAge}" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/>
        <ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedAge, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Cảnh báo (nếu có) -->
        <ItemsControl ItemsSource="{Binding Warnings}" IsTabStop="False" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="13"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource WarningBrush}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="13"
                       Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
            <TextBlock Text="{DynamicResource Custom.Dialog.Permanent}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
        </DockPanel>
    </StackPanel>
</UserControl>
