<UserControl x:Class="DiskCleaner.UI.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource IconText}" FontSize="30" Opacity="0.55"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16"
                   FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,4" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource SubtitleText}" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
