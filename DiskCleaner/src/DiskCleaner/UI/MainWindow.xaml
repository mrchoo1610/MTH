<Window x:Class="DiskCleaner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskCleaner.UI.ViewModels"
        xmlns:views="clr-namespace:DiskCleaner.UI.Views"
        Title="{DynamicResource App.Name}" Width="1180" Height="760" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanViewModel}"><views:CleanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyzerViewModel}"><views:AnalyzerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}"><views:LargeFilesView/></DataTemplate>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10" Padding="16,11" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="0" Background="{StaticResource AccentGradient}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar (cao hết cửa sổ; 40px trên cùng là vùng kéo cửa sổ) -->
            <Border Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,40,20,28">
                        <Image Source="pack://application:,,,/Assets/app.png" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource App.Name}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource App.Tagline}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="20,12,20,20" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="3"
                                ToolTip="{DynamicResource Lang.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="lang" Content="VI" Style="{StaticResource SegmentedRadioButton}"
                                             IsChecked="{Binding IsVietnamese, Mode=TwoWay}"/>
                                <RadioButton GroupName="lang" Content="EN" Style="{StaticResource SegmentedRadioButton}"
                                             IsChecked="{Binding IsEnglish, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- Link cập nhật (dưới cùng, phía trên bộ chọn ngôn ngữ) -->
                    <Button DockPanel.Dock="Bottom" Margin="12,0,12,0" Command="{Binding CheckUpdateCommand}"
                            Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="16,9"
                            ToolTip="{Binding UpdateTooltip}" AutomationProperties.AutomationId="CheckUpdateLink">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="15" Width="30"
                                       TextAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{DynamicResource Update.Link}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <Ellipse Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{StaticResource AccentGradientDiagonal}"
                                     Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Button>

                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="17"
                                               Width="30" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Title bar tự vẽ: nút Min/Max/Close -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"
                        ToolTip="{DynamicResource Window.Minimize}"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize"
                        ToolTip="{DynamicResource Window.Maximize}"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose"
                        ToolTip="{DynamicResource Window.Close}"/>
            </StackPanel>

            <!-- Nội dung trang, có hiệu ứng chuyển tab (fade + trượt 8px) -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Grid.Row="1" Margin="32,8,32,24"
                            Content="{Binding SelectedPage.ViewModel}" IsTabStop="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageTranslate" Y="0"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Border>
</Window>
